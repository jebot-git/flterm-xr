#!/usr/bin/env python3
"""Control the local FLTerm XR overlay (suitable for KDE global shortcuts)."""
import argparse
import math
import os
import socket
import tempfile

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--socket', help='Explicit control socket (Wayland instances print their own path)')
commands = parser.add_subparsers(dest='command', required=True)
for name in ('status', 'show', 'hide', 'toggle', 'focus', 'quit', 'tab-new', 'tab-next', 'tab-prev', 'tab-close', 'reset-layout'):
    commands.add_parser(name)
commands.add_parser('tab-select', help='Select a tab by its 1-based number').add_argument('index', type=int)
commands.add_parser('type', help='Send exact UTF-8 text to the shell').add_argument('text')
size = commands.add_parser('size', help='Quad width and height in meters')
size.add_argument('width', type=float)
size.add_argument('height', type=float)
position = commands.add_parser('position', help='Head-relative meters, X right, Y up, Z back (negative in front)')
for name in ('x', 'y', 'z'):
    position.add_argument(name, type=float)
move = commands.add_parser('move', help='Move relative to the current position, in meters')
for name in ('dx', 'dy', 'dz'):
    move.add_argument(name, type=float)
resize = commands.add_parser('resize', help='Change width/height by these meter deltas')
resize.add_argument('dw', type=float)
resize.add_argument('dh', type=float)
commands.add_parser('scale', help='Scale both dimensions, preserving aspect ratio').add_argument('factor', type=float)
commands.add_parser('opacity', help='Background opacity; 0 is fully transparent').add_argument('alpha', type=float)
args = parser.parse_args()
command = args.command
if command == 'tab-select':
    if not 1 <= args.index <= 16:
        parser.error('Tab number must be between 1 and 16')
    command += ' ' + str(args.index)
elif command == 'type':
    command += ' ' + args.text
elif command in ('size', 'position', 'opacity', 'move', 'resize', 'scale'):
    values = [value for key, value in vars(args).items() if key not in ('command', 'socket')]
    if not all(math.isfinite(v) for v in values):
        parser.error('Values must be finite')
    if command == 'size' and not (0 < args.width <= 10 and 0 < args.height <= 10):
        parser.error('Size must be in (0, 10] meters')
    if command == 'position' and not (abs(args.x) <= 10 and abs(args.y) <= 10 and -20 <= args.z <= -.2):
        parser.error('Position requires |X| and |Y| <= 10, and -20 <= Z <= -0.2')
    if command == 'scale' and args.factor <= 0:
        parser.error('Scale factor must be positive')
    if command == 'opacity' and not 0 <= args.alpha <= 1:
        parser.error('Opacity must be between 0 and 1')
    command += ' ' + ' '.join(map(str, values))
try:
    path = args.socket or os.path.join(os.environ['XDG_RUNTIME_DIR'], 'flterm-xr', 'control.sock')
    with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as sock:
        reply = None
        try:
            if args.command == 'status':
                fd, reply = tempfile.mkstemp(prefix='reply-', dir=os.path.dirname(path))
                os.close(fd)
                os.unlink(reply)
                sock.bind(reply)
                sock.settimeout(2)
            sock.sendto(command.encode(), path)
            if args.command == 'status':
                print(sock.recv(65536).decode())
        finally:
            if reply:
                os.unlink(reply)
except (OSError, KeyError) as exc:
    parser.exit(1, f'flterm-xrctl: {exc}\n')
